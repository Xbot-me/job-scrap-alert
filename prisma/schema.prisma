generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A lead is a post where someone is asking for help that you can answer
// directly: an email address, a Reddit DM, or (last resort) an apply link.
// Remote, hybrid and on-site work in any country are all fair game.
// Rejected posts are never stored, so everything here is worth a look.

enum Employment {
  FREELANCE // one-off / project work: fastest path to getting paid
  CONTRACT
  PART_TIME
  FULL_TIME
  UNKNOWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum LeadStatus {
  NEW
  SAVED
  CONTACTED
  HIDDEN
}

enum RemoteScope {
  WORLDWIDE // explicitly open to anywhere
  ASIA_OK // explicitly mentions Asia / APAC / Bangladesh / GMT+6
  TIMEZONE // remote, but wants overlap with US/EU hours
  REGION // remote, but only for people in a named country/region
  UNSTATED // remote, no restriction mentioned
}

model Lead {
  id          String      @id @default(cuid())
  source      String // e.g. "HN Who's Hiring", "r/forhire"
  externalId  String
  url         String // the original post
  title       String
  company     String?
  body        String      @db.Text
  emails      String[]
  redditUser  String?
  applyUrl    String?
  pay         String?
  employment  Employment  @default(UNKNOWN)
  workMode    WorkMode    @default(REMOTE)
  remote      RemoteScope? // only for REMOTE leads
  country     String? // country or region the job is tied to; null = anywhere
  language    String      @default("en")
  visa        Boolean     @default(false) // visa sponsorship or relocation offered
  skills      String[]
  score       Int
  reasons     String[]
  postedAt    DateTime
  firstSeenAt DateTime    @default(now())
  status      LeadStatus  @default(NEW)
  contactedAt DateTime?

  @@unique([source, externalId])
  @@index([status, score])
  @@index([country])
}

model SyncRun {
  id      String   @id @default(cuid())
  at      DateTime @default(now())
  fetched Int
  kept    Int
  added   Int
  errors  String[]
}
