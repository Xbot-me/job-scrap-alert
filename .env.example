# --- Leads board ---
# PostgreSQL connection string for Prisma migrations, seeding, and runtime.
DATABASE_URL="postgresql://username:password@localhost:5432/scrap_jobs_leads?schema=public"


# --- Outreach (used to pre-fill every email / Reddit message) ---
OUTREACH_NAME="Your Name"
OUTREACH_CV_URL="https://drive.google.com/your-cv-link"   # must be publicly viewable
OUTREACH_PORTFOLIO_URL=""   # its tech stack is used to rank leads
OUTREACH_GITHUB_URL=""
OUTREACH_HEADLINE="full-stack developer"
OUTREACH_PROOF=""   # one sentence: your strongest shipped result
OUTREACH_YEARS="6"
OUTREACH_LOCATION="Dhaka, Bangladesh"

# --- Legacy Telegram AI Job Alert Bot (Phase 0) ---
# Used exclusively by job_alert.py
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
